<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ==================================================================
         悬浮窗尺寸（改这里改大小，改完重新编译）
         Android 官方建议触摸目标不小于 48dp，太小会不好点。
         ================================================================== -->

    <!-- 展开状态：面板宽度 -->
    <dimen name="float_panel_width">222dp</dimen>

    <!-- 折叠状态：圆形外框直径  ★ 想让缩放后的图标更小，改这一行 ★
         推荐档位：
             56dp（默认，好点）
             48dp（官方最小触摸尺寸）
             40dp（够小，但点起来开始费劲）
             36dp（很小，只适合真机分辨率高的屏）
         注意：改这个的同时，把下面的 logo 尺寸一起按比例调小（一般 = 外框 × 0.78） -->
    <dimen name="float_collapsed_size">56dp</dimen>

    <!-- 折叠状态：里面 logo 图标的大小 -->
    <dimen name="float_collapsed_logo">44dp</dimen>

    <!-- 展开状态：标题栏左侧的小 logo -->
    <dimen name="float_title_logo">18dp</dimen>

</resources>
